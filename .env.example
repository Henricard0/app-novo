# Copie para .env.local e preencha.
#
# Opção 1 — emuladores locais (sem conta no Firebase): rode `npm run emuladores` e use:
VITE_FIREBASE_EMULADOR=true
VITE_FIREBASE_PROJECT_ID=demo-triade
VITE_FIREBASE_API_KEY=demo-chave
VITE_FIREBASE_AUTH_DOMAIN=demo-triade.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
#
# Opção 2 — projeto no Firebase: Project settings → General → Your apps → Config.
# Esses valores são públicos (vão dentro do site). Nunca coloque aqui chaves de "Service accounts".
# VITE_FIREBASE_EMULADOR=false
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
