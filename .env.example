# Copie para .env e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Estes valores são públicos por natureza:
# a segurança vem das regras RLS do banco. NUNCA coloque a chave da Anthropic aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
