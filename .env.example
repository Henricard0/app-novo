# Copie para .env.local e preencha.
# Com o Supabase local rodando (npm run db:start), os valores aparecem em `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Chave pública do projeto ("Publishable key" ou "anon key"). Nunca use a chave service_role no front.
VITE_SUPABASE_PUBLISHABLE_KEY=
