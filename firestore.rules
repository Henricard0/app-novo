rules_version = '2';

// Regras de segurança do Firestore — fazem o papel da RLS (CLAUDE.md, regras 1 e 2).
//   * Tudo é negado por padrão; cada coleção libera só o necessário.
//   * Toda coleção nova ganha regras aqui e testes por papel em tests/regras/.
//   * O supervisor nunca recebe acesso a pacientes, prontuários ou às fontes dos casos.
//   * Registro clínico não é apagado (soft delete com deleted_at); a partir da Fase 1,
//     dado clínico também exige e-mail confirmado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function eDono(uid) {
      return logado() && request.auth.uid == uid;
    }

    function nomeValido(d) {
      return d.full_name is string
        && d.full_name.trim().size() >= 1
        && d.full_name.size() <= 200;
    }

    // Região e número do CRP: os dois preenchidos, no formato certo, ou os dois nulos (estagiário).
    function crpValido(d) {
      return (d.crp_region == null && d.crp_number == null)
        || (d.crp_region is string && d.crp_region.matches('^(0[1-9]|[1-9][0-9])$')
            && d.crp_number is string && d.crp_number.matches('^[0-9]{1,6}$'));
    }

    // profiles/{uid}: um perfil por usuário. Cada um lê e edita só o próprio.
    // Leitura por supervisor e estagiário entra nas Fases 2 e 4 (vínculos).
    match /profiles/{uid} {
      allow get: if eDono(uid);
      allow list: if false;

      allow create: if eDono(uid)
        && request.resource.data.keys().hasOnly(['full_name', 'crp_region', 'crp_number', 'created_at', 'updated_at'])
        && request.resource.data.keys().hasAll(['full_name', 'crp_region', 'crp_number', 'created_at', 'updated_at'])
        && nomeValido(request.resource.data)
        && crpValido(request.resource.data)
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      allow update: if eDono(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name', 'crp_region', 'crp_number', 'updated_at'])
        && nomeValido(request.resource.data)
        && crpValido(request.resource.data)
        && request.resource.data.updated_at == request.time;

      allow delete: if false;
    }

    // Qualquer outro caminho: negado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
